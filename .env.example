# Postgres connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/zepkart
# Long random string used to sign session cookies (required in production)
JWT_SECRET=change-me-to-a-long-random-string
# Password required for "Signup as admin" (required in production; dev falls back to a demo password)
ADMIN_ACCESS_PASSWORD=change-me-admin-password
# Required to call /api/seed (send as x-seed-token header)
SEED_TOKEN=change-me-too
# Set to 1 to stop the /auth demo buttons from creating demo data on an empty database
# DISABLE_DEMO_SEED=1
