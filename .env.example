# Postgres connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/zepkart
# Long random string used to sign session cookies (required in production)
JWT_SECRET=change-me-to-a-long-random-string
# Where uploaded images and videos are stored on disk (default: ./storage/uploads)
UPLOAD_DIR=./storage/uploads
# Required to call /api/seed in production (send as x-seed-token header)
SEED_TOKEN=change-me-too
